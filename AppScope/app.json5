{
  "app": {
    "bundleName": "com.liaocaosix.qwenpawmobile",
    "vendor": "example",
    "versionCode": 1000000,
    "versionName": "1.0.0",
    "icon": "$media:layered_image",
    "label": "$string:app_name",
    // Without this, ArkUI pins every fp token to 1.0 and the system's font-size
    // setting silently does nothing to this app.
    "configuration": "$profile:configuration"
  }
}
